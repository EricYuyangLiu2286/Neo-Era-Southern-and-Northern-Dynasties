	name = "nesnd_cabinet_characters"
	ignoreinvisible = yes
	margin_bottom = 1

	widget = {
		size = { 510 280 }

		background = {
			margin = { 25 0 }
			alpha = 0.3
			using = top_illu_properties
			texture = "gfx/interface/illustrations/journal/nesnd_power/nesnd_power_panel_cabinet.dds"
		}

		textbox = {
			position = { 20 20 }
			size = { 180 24 }
			align = hcenter|nobaseline
			using = fontsize_medium
			text = "nesnd_power_label_leader"
		}
		nesnd_power_portrait_slot = {
			position = { 30 50 }
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('nesnd_power_leader_portrait')]"
		}

		textbox = {
			position = { 310 20 }
			size = { 180 24 }
			align = hcenter|nobaseline
			using = fontsize_medium
			text = "nesnd_cabinet_label_holder"
		}
		nesnd_power_portrait_slot = {
			position = { 320 50 }
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('nesnd_power_holder_portrait')]"
		}

		textbox = {
			position = { 195 120 }
			size = { 120 60 }
			align = hcenter|nobaseline
			multiline = yes
			using = fontsize_medium
			text = "nesnd_cabinet_label_center"
		}
	}
}

### 状态与诏令卡片（两个日志共用）
flowcontainer = {
	name = "nesnd_power_decrees"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		minimumsize = { 560 -1 }
		maximumsize = { 560 -1 }
		parentanchor = hcenter
		spacing = 5
		margin = { 0 12 }
		margin_top = 10
		ignoreinvisible = yes

		textbox = {
			minimumsize = { 560 -1 }
			maximumsize = { 560 -1 }
			autoresize = yes
			align = hcenter|nobaseline
			using = fontsize_large
			text = "nesnd_power_status_line"
		}

		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			spacing = 6
			ignoreinvisible = yes

			background = {
				alpha = 0.2
				margin = { 10 0 }
				using = entry_bg_fancy_dark
			}

			panel_dropdown = {
				blockoverride "section_header_left_text" {
					text = "nesnd_power_decrees_header"
				}
				blockoverride "section_header_right_text" {
					raw_text = "#v [GetDataModelSize(JournalEntry.GetScriptedButtons)]#!"
				}
				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('nesnd_power_decrees_collapsed')]"
				}
				blockoverride "onclick_showmore" {
					visible = "[GetVariableSystem.Exists('nesnd_power_decrees_collapsed')]"
				}
				blockoverride "onclick_showless" {
					visible = "[Not(GetVariableSystem.Exists('nesnd_power_decrees_collapsed'))]"
				}
				blockoverride "items_visibility" {
					visible = "[Not(GetVariableSystem.Exists('nesnd_power_decrees_collapsed'))]"
				}
				blockoverride "items_parentanchor" {
					parentanchor = hcenter
				}
				blockoverride "dropdown_datamodel" {
					minimumsize = { 528 -1 }
					maximumsize = { 528 -1 }
					flipdirection = yes
					datamodel_wrap = 2
					datamodel = "[JournalEntry.GetScriptedButtons]"
				}
				blockoverride "item" {
					widget = {
						size = { 264 128 }
						nesnd_power_decree_button = {
							parentanchor = center
						}
					}
				}
				blockoverride "second_list" {}
				blockoverride "empty_state_visibility" {
					visible = no
				}
			}
		}
	}
}

### 原版按钮区留空（照 widget_je_tsarpoints_buttons：登记空控件，让 journal_entry.gui 不再绘制默认按钮）
flowcontainer = {
	name = "nesnd_power_buttons_empty"
	ignoreinvisible = yes
	widget = {
		size = { 0 0 }
	}
}
