flowcontainer = {
    name = "nesnd_succession_country_table"
    direction = vertical
    spacing = 6
    max_width = 500
    textbox = {
        autoresize = yes
        text = "nesnd_board_table_heading"
        using = fontsize_large
    }
    dynamicgridbox = {
        datamodel = "[JournalEntry.GetInvolvedCountries]"
        datamodel_wrap = 1
        flipdirection = yes
        item = {
            flowcontainer = {
                direction = vertical
                spacing = 2
                max_width = 500
                background = { using = entry_bg }
                flowcontainer = {
                    direction = horizontal
                    spacing = 6
                    small_flag = {}
                    textbox = {
                        autoresize = yes
                        raw_text = "[Country.GetName] — [Country.GetCustom('nesnd_board_stance_loc')]"
                        using = fontsize_medium
                    }
                }
                textbox = {
                    autoresize = yes
                    multiline = yes
                    minimumsize = { 480 -1 }
                    maximumsize = { 480 -1 }
                    text = "nesnd_board_country_metrics"
                    using = fontsize_small
                }
            }
        }
    }
}
