# 唐衣大食「三教消长」：天命说版，三位代表人物（什叶、逊尼、天命说），每席只显示本国头像列表中的现任代表。
flowcontainer = {
    name = "nesnd_per_faith_mandate_representatives"
    direction = horizontal
    spacing = 8
    margin = { 10 6 }
    flowcontainer = {
        direction = vertical
        spacing = 2
        margin = { 4 0 }
        textbox = {
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            text = "nesnd_per_faith_rep_label_shia"
            using = fontsize_medium
        }
        nesnd_per_rep_portrait_list = {
            datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('nesnd_per_rep_shia_portrait')]"
        }
    }
    flowcontainer = {
        direction = vertical
        spacing = 2
        margin = { 4 0 }
        textbox = {
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            text = "nesnd_per_faith_rep_label_sunni"
            using = fontsize_medium
        }
        nesnd_per_rep_portrait_list = {
            datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('nesnd_per_rep_sunni_portrait')]"
        }
    }
    flowcontainer = {
        direction = vertical
        spacing = 2
        margin = { 4 0 }
        textbox = {
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            text = "nesnd_per_faith_rep_label_mandate"
            using = fontsize_medium
        }
        nesnd_per_rep_portrait_list = {
            datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('nesnd_per_rep_mandate_portrait')]"
        }
    }
}

textbox = {
    name = "nesnd_per_faith_mandate_rules"
    text = "nesnd_per_faith_mandate_rules"
    autoresize = yes
    multiline = yes
    min_width = 510
    max_width = 510
    margin = { 15 15 }
    align = nobaseline
    using = default_list_position
    background = { using = entry_bg }
}
