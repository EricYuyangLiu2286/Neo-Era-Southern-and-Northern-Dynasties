# 唐衣大食「三教消长」：天命说版，三位代表人物（什叶、逊尼、天命说），人物取自国家变量（参照原版日本与沙皇日志的写法）。
flowcontainer = {
    name = "nesnd_per_faith_mandate_representatives"
    direction = horizontal
    spacing = 8
    margin = { 10 6 }
    flowcontainer = {
        direction = vertical
        spacing = 2
        margin = { 4 0 }
        textbox = {
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            text = "nesnd_per_faith_rep_label_shia"
            using = fontsize_medium
        }
        widget = {
            size = { 150 178 }
            datacontext = "[JournalEntry.GetCountry.MakeScope.Var('nesnd_per_rep_shia').GetCharacter]"
            character_portrait_medium_torso = {
                visible = "[Character.IsValid]"
                parentanchor = center
                scale = 0.95
            }
        }
        textbox = {
            datacontext = "[JournalEntry.GetCountry.MakeScope.Var('nesnd_per_rep_shia').GetCharacter]"
            visible = "[Character.IsValid]"
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            maximumsize = { 150 -1 }
            multiline = yes
            raw_text = "[Character.GetFullName]"
            using = fontsize_small
        }
    }
    flowcontainer = {
        direction = vertical
        spacing = 2
        margin = { 4 0 }
        textbox = {
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            text = "nesnd_per_faith_rep_label_sunni"
            using = fontsize_medium
        }
        widget = {
            size = { 150 178 }
            datacontext = "[JournalEntry.GetCountry.MakeScope.Var('nesnd_per_rep_sunni').GetCharacter]"
            character_portrait_medium_torso = {
                visible = "[Character.IsValid]"
                parentanchor = center
                scale = 0.95
            }
        }
        textbox = {
            datacontext = "[JournalEntry.GetCountry.MakeScope.Var('nesnd_per_rep_sunni').GetCharacter]"
            visible = "[Character.IsValid]"
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            maximumsize = { 150 -1 }
            multiline = yes
            raw_text = "[Character.GetFullName]"
            using = fontsize_small
        }
    }
    flowcontainer = {
        direction = vertical
        spacing = 2
        margin = { 4 0 }
        textbox = {
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            text = "nesnd_per_faith_rep_label_mandate"
            using = fontsize_medium
        }
        widget = {
            size = { 150 178 }
            datacontext = "[JournalEntry.GetCountry.MakeScope.Var('nesnd_per_rep_mandate').GetCharacter]"
            character_portrait_medium_torso = {
                visible = "[Character.IsValid]"
                parentanchor = center
                scale = 0.95
            }
        }
        textbox = {
            datacontext = "[JournalEntry.GetCountry.MakeScope.Var('nesnd_per_rep_mandate').GetCharacter]"
            visible = "[Character.IsValid]"
            autoresize = yes
            align = hcenter|nobaseline
            minimumsize = { 150 -1 }
            maximumsize = { 150 -1 }
            multiline = yes
            raw_text = "[Character.GetFullName]"
            using = fontsize_small
        }
    }
}

textbox = {
    name = "nesnd_per_faith_mandate_rules"
    text = "nesnd_per_faith_mandate_rules"
    autoresize = yes
    multiline = yes
    min_width = 510
    max_width = 510
    margin = { 15 15 }
    align = nobaseline
    using = default_list_position
    background = { using = entry_bg }
}
