# 教士秀全的人物像。仿原版 gui/journal_entry_widgets/tsarpoints_widgets.gui 的 widget_je_tsarpoints_characters。
# 参照 ep2_japan_widgets.gui 的大名列表：只为列表中的人物创建头像。
flowcontainer = {
	name = "nesnd_xq_portrait"
	ignoreinvisible = yes
	margin_bottom = 1

	widget = {
		size = { 510 300 }

		background = {
			texture = "gfx/interface/illustrations/journal/je_group_illu_qing.dds"
			using = top_illu_properties
			margin = { 25 0 }
			alpha = 0.3
		}

		fixedgridbox = {
			position = { 95 0 }
			size = { 320 300 }
			addcolumn = 320
			addrow = 300
			datamodel = "[JournalEntry.MakeScope.GetList('nesnd_xq_portrait_characters')]"

			item = {
				widget = {
					size = { 320 300 }
					visible = "[Scope.GetCharacter.IsValid]"
					character_portrait_xl_torso_tsarpoint = {
						datacontext = "[Scope.AccessCharacter]"
						visible = "[And( Character.IsValid, Not(Character.IsHistorical) )]"
						parentanchor = center
						scale = 0.756
					}

					character_portrait_xl_torso_tsarpoint_historical_info_link = {
						datacontext = "[Scope.AccessCharacter]"
						visible = "[And3( Character.IsValid, Character.IsHistorical, Not(StringIsEmpty(Character.GetHistoricalUrl)) )]"
						parentanchor = center
						scale = 0.756
					}

					character_portrait_xl_torso_tsarpoint_historical_no_info_link = {
						datacontext = "[Scope.AccessCharacter]"
						visible = "[And3( Character.IsValid, Character.IsHistorical, StringIsEmpty(Character.GetHistoricalUrl) )]"
						parentanchor = center
						scale = 0.756
					}
				}
			}
		}
	}
}
