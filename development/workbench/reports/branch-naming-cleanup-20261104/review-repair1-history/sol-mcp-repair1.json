      {
        "name": "search_references",
        "title": null,
        "description": "\n    Search for a string across all game script files.\n\n    Use this to find which files reference a flag, event ID, or any other string.\n    By default returns only file paths (token-efficient).\n    Set include_lines=True to also return matching line numbers and content.\n\n    Args:\n        query: String to search for (literal match)\n        glob_pattern: Glob pattern relative to game directory (default: **/*.txt)\n        include_lines: If True, include matching line numbers and content\n\n    Returns:\n        List of files (and optionally lines) containing the query.\n    ",
        "inputSchema": {
          "properties": {
            "query": {
              "title": "Query",
              "type": "string"
            },
            "glob_pattern": {
              "default": "**/*.txt",
              "title": "Glob Pattern",
              "type": "string"
            },
            "include_lines": {
              "default": false,
              "title": "Include Lines",
              "type": "boolean"
            }
