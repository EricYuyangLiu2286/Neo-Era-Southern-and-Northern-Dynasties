      {
        "name": "get_structure",
        "title": null,
        "description": "\n    Get the structure of a symbol (keys only, no full content).\n\n    This is the key token-saving tool: shows what keys exist in a block\n    without dumping the full script content. Use this to understand\n    what a focus, event, or decision contains before requesting specifics.\n\n    Args:\n        file_path: Relative path to the file (required)\n                  (e.g., \"common/national_focus/japan.txt\")\n        symbol: Name of the symbol to inspect\n               (e.g., \"JAP_the_unthinkable_option\", \"japan.1\")\n        key_path: Optional dot-separated path to navigate into nested blocks\n                 (e.g., \"completion_reward\", \"completion_reward.hidden_effect\")\n                 Paths with 2+ segments trigger full content expansion instead\n                 of \"[block]\" placeholders — use this to read nested conditions.\n\n    Returns:\n        Compact structure showing keys and value types.\n        Block values show \"[block]\" instead of full content.\n        At depth >= 2 (via key_path), blocks are fully expanded.\n    ",
        "inputSchema": {
          "properties": {
            "file_path": {
              "title": "File Path",
              "type": "string"
            },
            "symbol": {
              "title": "Symbol",
              "type": "string"
            },
            "key_path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Key Path"
            }
          },
          "required": [
            "file_path",
            "symbol"
          ],
          "title": "get_structureArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "get_structureOutput",
          "type": "object"
        },
        "icons": null,
        "annotations": null,
        "meta": null,
        "execution": null
