--- base/common/on_actions/nesnd_war_collapse.txt
+++ candidate/common/on_actions/nesnd_war_collapse.txt
@@ -0,0 +1,36 @@
+# Vanilla 00_code_on_actions.txt: battle roots are countries; scope:enemy_country is the opposing country.
+on_battle_ended = { on_actions = { nesnd_war_collapse_after_battle } }
+on_empty_battle_won = { on_actions = { nesnd_war_collapse_after_battle } }
+nesnd_war_collapse_after_battle = {
+    effect = {
+        if = {
+            limit = { OR = { c:USM ?= this scope:enemy_country ?= c:USM } }
+            c:USM ?= { nesnd_queue_war_collapse_check = yes }
+        }
+    }
+}
+# Native callbacks: root is the victorious country; scope:target is the defeated enemy.
+# on_enemy_capitulated_notification also fires when that enemy had no demands against it.
+on_wargoal_enforced = { on_actions = { nesnd_record_wu_defeat } }
+on_enemy_capitulated_notification = { on_actions = { nesnd_record_wu_defeat } }
+nesnd_record_wu_defeat = {
+    effect = {
+        if = {
+            limit = { c:USM ?= this has_variable = tag_WUU_var exists = scope:target }
+            scope:target = {
+                if = {
+                    limit = { is_country_alive = yes NOT = { c:USM ?= this } has_variable = usm_opposition_country }
+                    set_variable = nesnd_south_defeat_confirmed
+                }
+            }
+            if = {
+                limit = { exists = c:JAP }
+                if = {
+                    limit = { scope:target = c:JAP c:JAP = { is_country_alive = yes } NOT = { has_global_variable = nesnd_japan_partitioned } }
+                    set_variable = nesnd_japan_defeat_confirmed
+                }
+            }
+            nesnd_queue_war_collapse_check = yes
+        }
+    }
+}
--- base/common/scripted_effects/nesnd_war_collapse.txt
+++ candidate/common/scripted_effects/nesnd_war_collapse.txt
@@ -0,0 +1,48 @@
+# USM scope; the existing, previously exercised annex -> recovery -> partition chain owns the result.
+nesnd_japan_commit_war_collapse = {
+    if = {
+        limit = { nesnd_japan_collapse_ready = yes }
+        set_global_variable = nesnd_japan_collapse_committed
+        nesnd_japan_register_annex_target = yes
+        c:JAP = { every_scope_character = { limit = { is_character_alive = yes } transfer_character = c:USM } }
+        annex_as_civil_war = c:JAP
+        if = {
+            limit = { NOT = { c:JAP ?= { is_country_alive = yes } } }
+            set_variable = nesnd_japan_recovery_pending
+            remove_variable = nesnd_japan_annex_expected_country
+            nesnd_japan_recovery_request = yes
+        }
+    }
+}
+nesnd_check_war_collapses = {
+    if = {
+        limit = { c:USM ?= this is_country_alive = yes }
+        every_country = {
+            limit = { nesnd_south_capital_defeat = yes NOT = { has_variable = nesnd_capital_surrender_pending } }
+            trigger_event = { id = usm_civilwar.5 popup = yes }
+        }
+        nesnd_japan_commit_war_collapse = yes
+    }
+}
+nesnd_queue_war_collapse_check = {
+    if = {
+        limit = { c:USM ?= this is_country_alive = yes NOT = { has_variable = nesnd_war_collapse_check_queued } }
+        set_variable = { name = nesnd_war_collapse_check_queued days = 2 }
+        trigger_event = { id = nesnd_war_collapse.1 days = 1 }
+    }
+}
+# Contextless JE scope: update viewers, execute the actual outcome once in USM.
+nesnd_japan_collapse_refresh = {
+    every_country = {
+        limit = { nesnd_japan_collapse_viewer = yes NOT = { is_involved_in_journal_entry = nesnd_japan_war_collapse } }
+        scope:journal_entry ?= { add_involved_country = prev }
+    }
+    scope:journal_entry ?= {
+        every_scope_je_involved = {
+            if = {
+                limit = { NOT = { nesnd_japan_collapse_viewer = yes } }
+                scope:journal_entry ?= { remove_involved_country = prev }
+            }
+        }
+    }
+}
--- base/common/scripted_triggers/nesnd_war_collapse.txt
+++ candidate/common/scripted_triggers/nesnd_war_collapse.txt
@@ -0,0 +1,91 @@
+# Country scope. Restore the original capital OR occupation rule; Japan has its own two-centre rule.
+nesnd_south_capital_defeat = {
+    trigger_if = {
+        limit = { exists = c:USM }
+        is_country_alive = yes
+        has_variable = usm_opposition_country
+        NOT = { c:JAP ?= this }
+        NOT = { c:USM ?= this }
+        NOT = { is_subject_of = c:USM }
+        OR = {
+            has_variable = nesnd_south_defeat_confirmed
+            AND = {
+                has_war_with = c:USM
+                OR = {
+                    enemy_occupation > 0.8
+                    capital = { controller = c:USM }
+                    capital = { controller = { is_subject_of = c:USM } }
+                }
+            }
+        }
+    }
+    trigger_else = { always = no }
+}
+# Called only after a living JAP and USM are established. A friendly controller is not occupation.
+nesnd_japan_two_centres_lost = {
+    s:STATE_KYOTO = { any_scope_state = { owner = c:JAP controller = { has_war_with = c:JAP } } }
+    s:STATE_KANTO = { any_scope_state = { owner = c:JAP controller = { has_war_with = c:JAP } } }
+}
+# USM scope. An enforced demand / restored losing-side settlement is an independent defeat fact.
+nesnd_japan_collapse_ready = {
+    trigger_if = {
+        limit = { exists = c:JAP }
+        c:USM ?= this
+        is_country_alive = yes
+        has_variable = tag_WUU_var
+        c:JAP = { is_country_alive = yes NOT = { has_variable = nesnd_japan_recovery_created } }
+        NOT = { has_global_variable = nesnd_japan_partitioned }
+        NOT = { has_global_variable = nesnd_japan_collapse_committed }
+        OR = {
+            AND = { has_war_with = c:JAP nesnd_japan_two_centres_lost = yes }
+            has_variable = nesnd_japan_defeat_confirmed
+        }
+    }
+    trigger_else = { always = no }
+}
+nesnd_japan_collapse_viewer = {
+    trigger_if = {
+        limit = { exists = c:JAP }
+        is_country_alive = yes
+        OR = { c:JAP ?= this has_war_with = c:JAP }
+    }
+    trigger_else = { c:USM ?= this }
+}
+
+# Contextless: a real defeat must finish its country / recovery transaction before any status-quo verdict.
+nesnd_south_defeat_resolution_pending = {
+    trigger_if = {
+        limit = { exists = c:USM }
+        OR = {
+            any_country = {
+                is_country_alive = yes
+                has_variable = usm_opposition_country
+                NOT = { c:USM ?= this }
+                NOT = { is_subject_of = c:USM }
+                OR = { has_variable = nesnd_south_defeat_confirmed has_variable = nesnd_capital_surrender_pending }
+            }
+            AND = {
+                NOT = { has_global_variable = nesnd_japan_partitioned }
+                c:USM = {
+                    OR = {
+                        has_variable = nesnd_japan_recovery_pending
+                        AND = {
+                            has_variable = nesnd_japan_defeat_confirmed
+                            exists = c:JAP
+                            c:JAP ?= { is_country_alive = yes NOT = { has_variable = nesnd_japan_recovery_created } }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    trigger_else = { always = no }
+}
+nesnd_japan_at_war_with_wu = {
+    trigger_if = {
+        limit = { exists = c:USM exists = c:JAP }
+        c:JAP = { is_country_alive = yes }
+        c:USM = { is_country_alive = yes has_variable = tag_WUU_var has_war_with = c:JAP }
+    }
+    trigger_else = { always = no }
+}
