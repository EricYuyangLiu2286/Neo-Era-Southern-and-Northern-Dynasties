  "texts": {
    "nesnd_cne_respite_button": [
      "暂缓诸项改革",
      "Pause the Reforms"
    ],
    "nesnd_cne_respite_button_desc": [
      "朝廷暂缓土地商品化、国家城市化与各省营产改制，给地方留下安顿生计、平息争端的时日。",
      "The court will suspend land, urban and military-estate reforms, giving the provinces time to restore livelihoods and settle disputes."
    ],
    "nesnd_cne_respite_unused_tt": [
      "本轮地权革命尚未实行过全面暂缓。",
      "We have not yet called a general pause during this land revolution."
    ],
    "nesnd_cne_respite_over_tt": [
      "未处于改革暂缓期。",
      "No general reform pause is in effect."
    ],
    "nesnd_cne_respite_programs_tt": [
      "至少一项改革正在推行。",
      "At least one reform is underway."
    ],
    "nesnd_cne_respite_confidence_tt": [
      "人民的信心不高于#v 900#!。",
      "Public confidence is no higher than #v 900#!."
    ],
    "nesnd_cne_respite_effect_tt": [
      "暂停土地商品化、国家城市化与各省营产整顿，并撤回对应的临时修正。#v 6个月#!内不能重启这些改革；人民的信心#p +100#!。本轮地权革命只能实行一次。",
      "Pause land commercialisation, urbanisation and all military-estate reforms, removing their temporary modifiers. These reforms cannot be restarted for #v 6 months#!. Public confidence #p +100#!. This is available once during the land revolution."
    ],
    "nesnd_cne_confidence_respite_status": [
      "各省的改革暂缓推行。",
      "Reforms in the provinces have been temporarily suspended."
    ]
  },
