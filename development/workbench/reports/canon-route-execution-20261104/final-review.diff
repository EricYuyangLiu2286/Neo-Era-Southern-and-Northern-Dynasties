+nesnd_c2_garibaldi_general_here = {
+ trigger_if = { limit = { exists = scope:garibaldi_scope }
+  scope:garibaldi_scope = { is_character_alive = yes has_role_of_type = general owner = root }
+ }
+ trigger_else = { always = no }
+}
+nesnd_c2_garibaldi_departure_valid = {
+ trigger_if = { limit = { exists = scope:garibaldi_scope }
+  scope:garibaldi_scope = { is_character_alive = yes owner = root }
+  trigger_if = { limit = { exists = scope:garibaldi_italian_nation_scope }
+   scope:garibaldi_italian_nation_scope = { nesnd_c2_garibaldi_destination = yes }
+   exists = scope:nesnd_c2_garibaldi_play
+   scope:nesnd_c2_garibaldi_play ?= { is_war = yes OR = { initiator = scope:garibaldi_italian_nation_scope target = scope:garibaldi_italian_nation_scope } }
+  }
+  trigger_else = { is_at_war = no NOR = { c:ITA ?= this any_primary_culture = { has_discrimination_trait = heritage_italic } } }
+ }
+ trigger_else = { always = no }
+}
+nesnd_c2_rsm_current_play = {
+ exists = scope:rsm_scope exists = scope:rsm_revolted_scope exists = scope:rsm_diplo_play
+ scope:rsm_scope ?= { is_country_alive = yes is_secessionist = yes }
+ scope:rsm_diplo_play ?= { initiator = scope:rsm_revolted_scope target = scope:rsm_scope }
