--- baseline/common/journal_entries/nesnd_american_restoration.txt
+++ candidate/common/journal_entries/nesnd_american_restoration.txt
@@ -0,0 +1,31 @@
+nesnd_american_restoration = {
+ group = je_group_historical_content icon = "gfx/interface/icons/event_icons/waving_flag.dds"
+ should_be_pinned_by_default_uninvolved_or_context = yes can_revolution_inherit = no weight = 1000
+ is_shown_when_inactive = { nesnd_restoration_entry_visible = yes }
+ possible = { nesnd_restoration_entry_visible = yes }
+ immediate = { nesnd_restoration_initialize = yes }
+ scripted_progress_bar = nesnd_restoration_pressure_bar
+ scripted_button = nesnd_native_recognize scripted_button = nesnd_native_negotiate scripted_button = nesnd_native_suppress
+ on_monthly_pulse = { effect = { nesnd_restoration_monthly = yes } }
+ invalid = { NOT = { nesnd_restoration_entry_visible = yes } }
+ on_invalid = { if = { limit = { has_modifier = nesnd_native_local_councils } remove_modifier = nesnd_native_local_councils } }
+ status_desc = {
+  first_valid = {
+   triggered_desc = { trigger = { nesnd_restoration_invitation_applicant = yes } desc = nesnd_restoration_existing_court_status }
+   triggered_desc = { trigger = { nesnd_restoration_pressure_value >= 100 } desc = nesnd_restoration_waiting_land_status }
+   triggered_desc = { desc = nesnd_restoration_politics_status }
+  }
+ }
+}
+nesnd_native_restoration_war = {
+ group = je_group_historical_content icon = "gfx/interface/icons/event_icons/event_military.dds"
+ should_be_pinned_by_default_uninvolved_or_context = yes can_revolution_inherit = no weight = 1500
+ is_shown_when_inactive = { OR = { has_variable = nesnd_restoration_rebel has_variable = nesnd_restoration_war_host } NOT = { has_variable = nesnd_restoration_peace_shown } }
+ possible = { OR = { has_variable = nesnd_restoration_rebel has_variable = nesnd_restoration_war_host } NOT = { has_variable = nesnd_restoration_peace_shown } }
+ complete = { has_variable = nesnd_restoration_victory }
+ fail = { has_variable = nesnd_restoration_war_terminal NOT = { has_variable = nesnd_restoration_victory } }
+ on_complete = { set_variable = nesnd_restoration_peace_shown }
+ on_fail = { set_variable = nesnd_restoration_peace_shown }
+ invalid = { NOR = { has_variable = nesnd_restoration_rebel has_variable = nesnd_restoration_war_host } }
+ status_desc = { desc = nesnd_restoration_war_status }
+}
