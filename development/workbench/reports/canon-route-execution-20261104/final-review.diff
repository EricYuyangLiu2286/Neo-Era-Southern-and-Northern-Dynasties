+nesnd_c2_italian_agitation_target = {
+ is_country_alive = yes NOT = { this = root }
+ OR = { country_has_primary_culture = cu:north_italian country_has_primary_culture = cu:south_italian }
+ NOT = { has_variable = risorgimento_unifying_stance }
+ relations:root <= 20
+ any_political_movement = { is_political_movement_type = movement_italian_national }
