+        else_if = { limit = { has_variable = nesnd_hus_registration_wait }
+            set_global_variable = { name = nesnd_hus_registration_record_state value = 5 }
+            set_variable = { name = nesnd_hus_registration_clock_source value = this }
+        }
+        else = { set_global_variable = { name = nesnd_hus_registration_record_state value = 2 } }
+    }
+}
+nesnd_hus_migrate_hierarchy = {
+    if = { limit = { nesnd_hus_original_country = yes NOT = { has_variable = nesnd_hus_hierarchy_version } }
+        set_variable = nesnd_hus_hierarchy_mutating
+        # Establish the route before replacing the legacy active citizenship law.
+        if = { limit = { has_law = law_type:law_nesnd_hus_registry_manchu }
+            if = { limit = { nesnd_hus_native_route = yes } set_variable = nesnd_hus_migration_conflict }
+            else = { set_variable = { name = nesnd_hus_registration_choice value = 1 } set_variable = nesnd_hus_registration_done }
+        }
+        if = { limit = { has_law = law_type:law_nesnd_hus_registry_native }
+            if = { limit = { nesnd_hus_manchu_route = yes } set_variable = nesnd_hus_migration_conflict }
+            else = { set_variable = { name = nesnd_hus_registration_choice value = 2 } set_variable = nesnd_hus_registration_done }
+        }
+        if = { limit = { has_variable = nesnd_hus_registration_done NOT = { nesnd_hus_valid_registration_choice = yes } }
+            if = { limit = { OR = { has_variable = nesnd_hus_manchu_exodus_pending has_variable = nesnd_hus_manchu_exodus_done } NOT = { has_variable = nesnd_khanate_campaign_started } }
+                set_variable = { name = nesnd_hus_registration_choice value = 2 }
+            }
+            else_if = { limit = { has_variable = nesnd_khanate_campaign_started NOR = { has_variable = nesnd_hus_manchu_exodus_pending has_variable = nesnd_hus_manchu_exodus_done } }
+                set_variable = { name = nesnd_hus_registration_choice value = 1 }
+            }
+            else = { set_variable = nesnd_hus_migration_conflict }
+        }
+        if = { limit = { has_variable = nesnd_hus_registration_choice NOT = { nesnd_hus_valid_registration_choice = yes } } set_variable = nesnd_hus_migration_conflict }
+        if = { limit = { OR = {
+            AND = { nesnd_hus_manchu_route = yes OR = { has_variable = nesnd_hus_manchu_exodus_pending has_variable = nesnd_hus_manchu_exodus_done } }
+            AND = { nesnd_hus_native_route = yes has_variable = nesnd_khanate_campaign_started }
+        } } set_variable = nesnd_hus_migration_conflict }
+        if = { limit = { NOT = { exists = var:nesnd_hus_frozen_citizenship_type } }
+            if = { limit = { nesnd_hus_has_legacy_law = yes }
+                set_variable = { name = nesnd_hus_frozen_citizenship_type value = law_type:law_cultural_exclusion }
+            }
+            else = {
+                clear_saved_scope = nesnd_hus_current_citizenship
+                active_law:lawgroup_citizenship ?= { save_scope_as = nesnd_hus_current_citizenship }
+                if = { limit = { exists = scope:nesnd_hus_current_citizenship }
+                    set_variable = { name = nesnd_hus_frozen_citizenship_type value = scope:nesnd_hus_current_citizenship.type }
+                }
+                else = { set_variable = { name = nesnd_hus_frozen_citizenship_type value = law_type:law_cultural_exclusion } }
+                clear_saved_scope = nesnd_hus_current_citizenship
+            }
+        }
+        set_variable = { name = nesnd_hus_hierarchy_version value = 2 }
+        set_variable = nesnd_hus_hierarchy_active
+        if = { limit = { NOT = { has_variable = nesnd_hus_migration_conflict } }
+            nesnd_hus_record_legacy_clock = yes
+            nesnd_hus_install_expected_hierarchy = yes
+        }
+        else = { nesnd_hus_clear_tiers = yes }
+        remove_variable = nesnd_hus_hierarchy_mutating
+        recalculate_pop_ig_support = yes
+    }
+}
+nesnd_hus_initialize_hierarchy = {
+    if = { limit = { nesnd_hus_original_country = yes NOT = { has_variable = nesnd_hus_hierarchy_mutating } }
+        nesnd_hus_migrate_hierarchy = yes
+        if = { limit = { has_variable = nesnd_hus_hierarchy_active NOT = { has_variable = nesnd_hus_migration_conflict } }
+            set_variable = nesnd_hus_hierarchy_mutating
+            nesnd_hus_install_expected_hierarchy = yes
+            remove_variable = nesnd_hus_hierarchy_mutating
+        }
+    }
+}
+nesnd_hus_suspend_revolution_hierarchy = {
+    if = { limit = { nesnd_hus_revolution_snapshot_valid = yes }
+        set_variable = nesnd_hus_hierarchy_mutating
+        set_variable = nesnd_hus_revolution_suspended
+        remove_variable = nesnd_hus_hierarchy_active
+        # A temporary revolutionary tag must never be classified as a permanent exit.
+        remove_variable = nesnd_hus_hierarchy_retired
+        nesnd_hus_uninstall_hierarchy = yes
+        if = { limit = { nesnd_hus_has_legacy_law = yes exists = var:nesnd_hus_frozen_citizenship_type } activate_law = var:nesnd_hus_frozen_citizenship_type }
+        remove_variable = nesnd_hus_hierarchy_mutating
+        recalculate_pop_ig_support = yes
+    }
+}
+nesnd_hus_restore_revolution_hierarchy = {
+    if = { limit = { c:HUS ?= this is_country_alive = yes nesnd_hus_revolution_snapshot_valid = yes }
+        set_variable = nesnd_hus_hierarchy_mutating
+        remove_variable = nesnd_hus_hierarchy_retired
+        remove_variable = nesnd_hus_revolution_suspended
+        set_variable = nesnd_hus_hierarchy_active
+        if = { limit = { nesnd_hus_epoch_matches_record = yes }
+            set_global_variable = { name = nesnd_hus_registration_record_owner value = this }
+            if = { limit = { has_global_variable = nesnd_hus_registration_record_state }
+                if = { limit = { global_var:nesnd_hus_registration_record_state = 3 }
+                    set_variable = nesnd_hus_registration_done
+                    if = { limit = { nesnd_hus_native_route = yes NOT = { has_variable = nesnd_hus_manchu_exodus_done } }
+                        if = { limit = { has_global_variable = nesnd_hus_registration_exodus_epoch }
+                            if = { limit = { global_var:nesnd_hus_registration_exodus_epoch = var:nesnd_hus_registration_epoch } set_variable = nesnd_hus_manchu_exodus_done }
+                        }
+                        if = { limit = { NOT = { has_variable = nesnd_hus_manchu_exodus_done } } set_variable = nesnd_hus_manchu_exodus_pending }
+                    }
+                }
+            }
+        }
+        nesnd_hus_install_expected_hierarchy = yes
+        remove_variable = nesnd_hus_hierarchy_mutating
+        recalculate_pop_ig_support = yes
+    }
+}
+nesnd_hus_clear_hierarchy = {
+    set_variable = nesnd_hus_hierarchy_mutating
+    # Only the actual current record owner can terminate a registration globally.
+    if = { limit = { nesnd_hus_epoch_matches_record = yes global_var:nesnd_hus_registration_record_owner ?= this }
+        set_global_variable = { name = nesnd_hus_registration_record_state value = 4 }
+        remove_global_variable = nesnd_hus_registration_wait
+    }
+    remove_variable = nesnd_hus_hierarchy_active
+    set_variable = nesnd_hus_hierarchy_retired
+    nesnd_hus_uninstall_hierarchy = yes
+    if = { limit = { nesnd_hus_has_legacy_law = yes }
+        if = { limit = { exists = var:nesnd_hus_frozen_citizenship_type } activate_law = var:nesnd_hus_frozen_citizenship_type }
+        else = { activate_law = law_type:law_cultural_exclusion }
+    }
+    remove_variable = nesnd_hus_registration_wait
+    remove_variable = nesnd_hus_frozen_citizenship_type
+    remove_variable = nesnd_hus_registration_clock_source
+    remove_variable = nesnd_hus_revolution_source
+    remove_variable = nesnd_hus_revolution_continuation
+    remove_variable = nesnd_hus_revolution_suspended
+    if = { limit = { has_variable = nesnd_hus_registration_epoch } change_variable = { name = nesnd_hus_registration_epoch add = 1 } }
+    remove_variable = nesnd_hus_hierarchy_mutating
+    recalculate_pop_ig_support = yes
+}
+nesnd_hus_choose_registration = {
+    if = { limit = { nesnd_hus_registration_open = yes NOT = { has_variable = nesnd_hus_registration_choice } }
+        set_variable = { name = nesnd_hus_registration_choice value = $CHOICE$ }
+        nesnd_hus_allocate_registration_epoch = yes
+        if = { limit = { has_variable = nesnd_hus_registration_epoch }
+            set_global_variable = { name = nesnd_hus_registration_record_state value = 1 }
+            set_global_variable = { name = nesnd_hus_registration_wait value = var:nesnd_hus_registration_epoch years = 1 }
+            set_variable = { name = nesnd_hus_registration_wait months = 12 }
+            save_scope_value_as = { name = nesnd_hus_delayed_epoch value = var:nesnd_hus_registration_epoch }
+            trigger_event = { id = nesnd_hus_registration.10 months = 12 }
+        }
+    }
+}
+nesnd_hus_update_registration_clock = {
+    if = { limit = { nesnd_hus_epoch_matches_record = yes has_global_variable = nesnd_hus_registration_record_state }
+        if = { limit = { global_var:nesnd_hus_registration_record_state = 1 NOT = { has_global_variable = nesnd_hus_registration_wait } }
+            set_global_variable = { name = nesnd_hus_registration_record_state value = 2 }
+        }
+        else_if = { limit = { global_var:nesnd_hus_registration_record_state = 5 }
+            if = { limit = { exists = var:nesnd_hus_registration_clock_source }
+                if = { limit = { var:nesnd_hus_registration_clock_source = { NOT = { has_variable = nesnd_hus_registration_wait } } }
+                    set_global_variable = { name = nesnd_hus_registration_record_state value = 2 }
+                }
+            }
+            else = { set_variable = nesnd_hus_migration_conflict }
+        }
+    }
+}
+nesnd_hus_registration_settle = {
+    if = { limit = { nesnd_hus_registration_open = yes nesnd_hus_valid_registration_choice = yes }
+        nesnd_hus_update_registration_clock = yes
+        if = { limit = { nesnd_hus_registration_clock_ready = yes NOT = { has_variable = nesnd_hus_migration_conflict } }
+            set_variable = nesnd_hus_hierarchy_mutating
+            if = { limit = { nesnd_hus_manchu_route = yes } activate_law = law_type:law_nesnd_hus_manchu_registration }
+            else_if = { limit = { nesnd_hus_native_route = yes } activate_law = law_type:law_nesnd_hus_native_registration }
+            if = { limit = { OR = {
+                AND = { nesnd_hus_manchu_route = yes has_law = law_type:law_nesnd_hus_manchu_registration }
+                AND = { nesnd_hus_native_route = yes has_law = law_type:law_nesnd_hus_native_registration }
+            } }
+                set_variable = nesnd_hus_registration_done
+                set_global_variable = { name = nesnd_hus_registration_record_state value = 3 }
+                remove_variable = nesnd_hus_registration_wait
+                remove_variable = nesnd_hus_registration_clock_source
+                if = { limit = { nesnd_hus_native_route = yes NOT = { has_variable = nesnd_hus_manchu_exodus_done } } set_variable = nesnd_hus_manchu_exodus_pending }
+            }
+            nesnd_hus_clear_tiers = yes nesnd_hus_sync_cmf_law = yes
+            remove_variable = nesnd_hus_hierarchy_mutating
+            recalculate_pop_ig_support = yes
+        }
+    }
+}
+
+# Country target scope; caller established the actual revolution source. Never copies timer expiry.
+nesnd_hus_copy_revolution_payload = {
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_hierarchy_version } }
+        set_variable = { name = nesnd_hus_hierarchy_version value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_hierarchy_version }
+    } else = { remove_variable = nesnd_hus_hierarchy_version }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_frozen_citizenship_type } }
+        set_variable = { name = nesnd_hus_frozen_citizenship_type value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_frozen_citizenship_type }
+    } else = { remove_variable = nesnd_hus_frozen_citizenship_type }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_registration_choice } }
+        set_variable = { name = nesnd_hus_registration_choice value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_registration_choice }
+    } else = { remove_variable = nesnd_hus_registration_choice }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_registration_done } }
+        set_variable = { name = nesnd_hus_registration_done value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_registration_done }
+    } else = { remove_variable = nesnd_hus_registration_done }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_registration_epoch } }
+        set_variable = { name = nesnd_hus_registration_epoch value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_registration_epoch }
+    } else = { remove_variable = nesnd_hus_registration_epoch }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_registration_clock_source } }
+        set_variable = { name = nesnd_hus_registration_clock_source value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_registration_clock_source }
+    } else = { remove_variable = nesnd_hus_registration_clock_source }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_manchu_exodus_pending } }
+        set_variable = { name = nesnd_hus_manchu_exodus_pending value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_manchu_exodus_pending }
+    } else = { remove_variable = nesnd_hus_manchu_exodus_pending }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_manchu_exodus_done } }
+        set_variable = { name = nesnd_hus_manchu_exodus_done value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_manchu_exodus_done }
+    } else = { remove_variable = nesnd_hus_manchu_exodus_done }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_khanate_campaign_started } }
+        set_variable = { name = nesnd_khanate_campaign_started value = scope:nesnd_hus_revolution_origin.var:nesnd_khanate_campaign_started }
+    } else = { remove_variable = nesnd_khanate_campaign_started }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_khanate_population_sent } }
+        set_variable = { name = nesnd_khanate_population_sent value = scope:nesnd_hus_revolution_origin.var:nesnd_khanate_population_sent }
+    } else = { remove_variable = nesnd_khanate_population_sent }
+    if = { limit = { scope:nesnd_hus_revolution_origin = { has_variable = nesnd_hus_migration_conflict } }
+        set_variable = { name = nesnd_hus_migration_conflict value = scope:nesnd_hus_revolution_origin.var:nesnd_hus_migration_conflict }
+    } else = { remove_variable = nesnd_hus_migration_conflict }
+}
+nesnd_hus_capture_revolution = {
+    # ROOT/source country scope, target is the native on_revolution_start target.
+    if = { limit = { nesnd_hus_original_country = yes has_variable = nesnd_hus_hierarchy_active exists = scope:target }
+        save_scope_as = nesnd_hus_revolution_origin
+        scope:target = {
+            if = { limit = { NOT = { has_variable = nesnd_hus_native_successor } NOT = { has_variable = nesnd_hus_revolution_continuation } }
+                set_variable = nesnd_hus_revolution_continuation
+                set_variable = { name = nesnd_hus_revolution_source value = scope:nesnd_hus_revolution_origin }
+                nesnd_hus_copy_revolution_payload = yes
+                remove_variable = nesnd_hus_hierarchy_retired
+                nesnd_hus_suspend_revolution_hierarchy = yes
+            }
+        }
+        clear_saved_scope = nesnd_hus_revolution_origin
+    }
+}
+nesnd_hus_reconcile_hierarchy = {
+    if = { limit = { is_country_alive = yes NOT = { has_variable = nesnd_hus_hierarchy_mutating } }
+        if = { limit = { OR = { c:NKH ?= this has_variable = nesnd_hus_native_successor } }
+            if = { limit = { OR = { has_variable = nesnd_hus_hierarchy_active has_social_hierarchy = nesnd_hus_social_hierarchy nesnd_hus_has_hierarchy_law = yes nesnd_hus_has_legacy_law = yes nesnd_hus_has_tier_modifier = yes has_variable = nesnd_hus_revolution_continuation } }
+                nesnd_hus_clear_hierarchy = yes
+            }
+            # The native successor is never subject to the HUS hierarchy or frozen citizenship.
+            if = { limit = { has_variable = nesnd_hus_native_successor NOT = { has_variable = nesnd_hus_native_legal_prepared } }
+                set_variable = nesnd_hus_native_legal_prepared
+                set_variable = nesnd_hus_hierarchy_mutating
+                set_social_hierarchy = default_social_hierarchy
+                if = { limit = { NOT = { has_law = law_type:law_racial_segregation } } activate_law = law_type:law_racial_segregation }
+                nesnd_native_primary_cultures_only = yes
+                remove_variable = nesnd_hus_hierarchy_mutating
+            }
+        }
+        else = {
+            # Recovery of a saved game already in a native revolution, before our start hook existed.
+            if = { limit = { NOT = { has_variable = nesnd_hus_revolution_continuation } is_revolutionary = yes exists = civil_war_origin_country
+                civil_war_origin_country ?= { nesnd_hus_original_country = yes has_variable = nesnd_hus_hierarchy_active }
+            }
+                civil_war_origin_country = { save_scope_as = nesnd_hus_revolution_origin }
+                set_variable = nesnd_hus_revolution_continuation
+                set_variable = { name = nesnd_hus_revolution_source value = scope:nesnd_hus_revolution_origin }
+                nesnd_hus_copy_revolution_payload = yes
+                remove_variable = nesnd_hus_hierarchy_retired
+                clear_saved_scope = nesnd_hus_revolution_origin
+            }
+            if = { limit = { c:HUS ?= this nesnd_hus_revolution_snapshot_valid = yes }
+                # Capture choices completed by the original government while the civil war ran.
+                if = { limit = { exists = var:nesnd_hus_revolution_source var:nesnd_hus_revolution_source ?= { exists = var:nesnd_hus_frozen_citizenship_type } }
+                    var:nesnd_hus_revolution_source = { save_scope_as = nesnd_hus_revolution_origin }
+                    nesnd_hus_copy_revolution_payload = yes
+                    clear_saved_scope = nesnd_hus_revolution_origin
+                }
+                nesnd_hus_restore_revolution_hierarchy = yes
+                remove_variable = nesnd_hus_revolution_continuation
+                remove_variable = nesnd_hus_revolution_source
+            }
+            else_if = { limit = { nesnd_hus_original_country = yes } nesnd_hus_initialize_hierarchy = yes }
+            else_if = { limit = { nesnd_hus_revolution_snapshot_valid = yes }
+                if = { limit = { OR = { NOT = { has_variable = nesnd_hus_revolution_suspended } has_social_hierarchy = nesnd_hus_social_hierarchy nesnd_hus_has_hierarchy_law = yes } }
+                    nesnd_hus_suspend_revolution_hierarchy = yes
+                }
+            }
+            else_if = { limit = { OR = { has_variable = nesnd_hus_hierarchy_active has_social_hierarchy = nesnd_hus_social_hierarchy nesnd_hus_has_hierarchy_law = yes nesnd_hus_has_legacy_law = yes nesnd_hus_has_tier_modifier = yes has_variable = nesnd_hus_revolution_continuation } }
+                nesnd_hus_clear_hierarchy = yes
+            }
+        }
+    }
+}
+nesnd_hus_manchu_exodus = {
+    nesnd_a2_manchu_exodus = yes
+}
+nesnd_hus_registration_maintenance = {
+    nesnd_hus_reconcile_hierarchy = yes
+    if = { limit = { nesnd_hus_original_country = yes has_variable = nesnd_hus_hierarchy_active }
+        nesnd_hus_registration_settle = yes
+        if = { limit = { nesnd_hus_registration_enacted_correctly = yes NOT = { has_variable = nesnd_hus_migration_conflict } }
+            nesnd_hus_manchu_exodus = yes
+            if = { limit = { nesnd_khanate_trigger_ready = yes NOT = { has_variable = nesnd_khanate_campaign_started } }
+                set_variable = nesnd_khanate_campaign_started
+            }
+        }
+    }
+}
--- baseline/common/scripted_effects/nesnd_native_khanate.txt
+++ candidate/common/scripted_effects/nesnd_native_khanate.txt
@@ -0,0 +1,263 @@
+nesnd_khanate_clear_selection = {
+ every_scope_state = {
+  if = { limit = { has_variable = nesnd_khanate_selected } remove_variable = nesnd_khanate_selected }
+  if = { limit = { has_variable = nesnd_khanate_excluded } remove_variable = nesnd_khanate_excluded }
+ }
+ clear_saved_scope = nesnd_khanate_1 clear_saved_scope = nesnd_khanate_2 clear_saved_scope = nesnd_khanate_3 clear_saved_scope = nesnd_khanate_4
+ clear_saved_scope = nesnd_khanate_capital
+}
+nesnd_khanate_choose_next = {
+ random_scope_state = {
+  limit = { nesnd_khanate_selected_neighbour = yes }
+  set_variable = nesnd_khanate_selected save_scope_as = nesnd_khanate_$SLOT$
+ }
+}
+nesnd_khanate_create = {
+ if = { limit = {
+  nesnd_hus_original_country = yes nesnd_khanate_trigger_ready = yes has_variable = nesnd_khanate_campaign_started NOT = { has_global_variable = nesnd_khanate_created }
+  exists = c:USA NOT = { exists = c:NKH } NOT = { has_variable = nesnd_khanate_selection_wait }
+ }
+  set_variable = { name = nesnd_khanate_selection_wait months = 1 }
+  save_scope_as = nesnd_khanate_original_hus
+  c:USA = {
+   nesnd_khanate_clear_selection = yes
+   if = { limit = { any_scope_state = { count >= 5 state_population > 0 } }
+    while = {
+     count = 15 limit = { NOT = { exists = scope:nesnd_khanate_4 } any_scope_state = { nesnd_khanate_eligible_state = yes NOT = { has_variable = nesnd_khanate_excluded } } }
+     random_scope_state = { limit = { nesnd_khanate_eligible_state = yes NOT = { has_variable = nesnd_khanate_excluded } } set_variable = nesnd_khanate_selected save_scope_as = nesnd_khanate_1 }
+     nesnd_khanate_choose_next = { SLOT = 2 } nesnd_khanate_choose_next = { SLOT = 3 } nesnd_khanate_choose_next = { SLOT = 4 }
+     if = { limit = { NOT = { exists = scope:nesnd_khanate_4 } }
+      every_scope_state = { limit = { has_variable = nesnd_khanate_selected } set_variable = nesnd_khanate_excluded remove_variable = nesnd_khanate_selected }
+      clear_saved_scope = nesnd_khanate_1 clear_saved_scope = nesnd_khanate_2 clear_saved_scope = nesnd_khanate_3
+     }
+    }
+   }
+   if = { limit = {
+    exists = scope:nesnd_khanate_1 exists = scope:nesnd_khanate_2 exists = scope:nesnd_khanate_3 exists = scope:nesnd_khanate_4
+    any_scope_state = { count = 4 has_variable = nesnd_khanate_selected nesnd_khanate_eligible_state = yes }
+    any_scope_state = { state_population > 0 NOT = { has_variable = nesnd_khanate_selected } }
+   }
+    ordered_scope_state = { limit = { NOT = { has_variable = nesnd_khanate_selected } state_population > 0 } order_by = state_population max = 1 state_region = { save_scope_as = nesnd_khanate_usa_capital } }
+    if = { limit = { capital = { has_variable = nesnd_khanate_selected } exists = scope:nesnd_khanate_usa_capital } nesnd_a2_set_capital = { TARGET = nesnd_khanate_usa_capital } }
+    create_country = {
+     tag = NKH origin = this
+     state = scope:nesnd_khanate_1 state = scope:nesnd_khanate_2 state = scope:nesnd_khanate_3 state = scope:nesnd_khanate_4
+     on_created = {
+      set_variable = nesnd_native_khanate set_variable = nesnd_a2_khanate_adopted make_independent = yes
+      set_variable = { name = nesnd_khanate_usa_epoch value = 1 } set_variable = { name = nesnd_khanate_hus_epoch value = 1 }
+      set_variable = { name = nesnd_khanate_original_usa value = c:USA }
+      set_variable = { name = nesnd_khanate_original_hus value = scope:nesnd_khanate_original_hus }
+      ordered_scope_state = { order_by = state_population max = 1 state_region = { save_scope_as = nesnd_khanate_capital } }
+      if = { limit = { exists = scope:nesnd_khanate_capital } nesnd_a2_set_capital = { TARGET = nesnd_khanate_capital } }
+     }
+    }
+    if = { limit = { nesnd_khanate_exists = yes c:NKH = { any_scope_state = { count = 4 state_population > 0 } } }
+     set_global_variable = nesnd_khanate_created
+     c:NKH = {
+      every_scope_state = { state_region = { add_claim = c:USA add_claim = scope:nesnd_khanate_original_hus } remove_variable = nesnd_khanate_selected }
+      set_variable = { name = nesnd_khanate_usa_outcome value = 0 } set_variable = { name = nesnd_khanate_hus_outcome value = 0 }
+      trigger_event = { id = nesnd_native_khanate.1 days = 1 }
+     }
+     nesnd_khanate_transfer_native_half = yes
+     c:NKH = { save_scope_as = nesnd_a2_khanate }
+     scope:nesnd_khanate_original_hus = { nesnd_khanate_transfer_native_half = yes trigger_event = { id = nesnd_hus_registration.1 popup = yes } }
+    }
+   }
+   nesnd_khanate_clear_selection = yes clear_saved_scope = nesnd_khanate_usa_capital
+  }
+  clear_saved_scope = nesnd_khanate_original_hus
+ }
+}
+nesnd_khanate_transfer_native_half = {
+ if = { limit = { nesnd_khanate_exists = yes is_country_alive = yes NOT = { c:NKH ?= this } NOT = { has_variable = nesnd_khanate_population_sent } }
+  set_variable = nesnd_khanate_population_sent
+  every_scope_state = { every_scope_pop = {
+   limit = { culture = { nesnd_hus_native_culture = yes } }
+   clear_saved_scope = nesnd_khanate_destination
+   c:NKH = { random_scope_state = { limit = { state_population > 0 } save_scope_as = nesnd_khanate_destination } }
+   if = { limit = { exists = scope:nesnd_khanate_destination scope:nesnd_khanate_destination = { owner = c:NKH } }
+    move_partial_pop = { state = scope:nesnd_khanate_destination population_ratio = 0.5 }
+   }
+  } }
+  clear_saved_scope = nesnd_khanate_destination
+ }
+}
+# COUNTRY scope; each type has a national upper bound, inherited levels count.
+nesnd_khanate_facility = {
+ set_variable = { name = nesnd_a2_facility_total value = 0 }
+ save_scope_as = nesnd_a2_facility_country
+ if = { limit = { exists = scope:nesnd_a2_facility_country has_variable = nesnd_a2_facility_total }
+ every_scope_state = { every_scope_building = {
+  limit = { is_building_type = $BUILDING$ }
+  scope:nesnd_a2_facility_country = { change_variable = { name = nesnd_a2_facility_total add = prev.level } }
+ } }
+ while = {
+  count = 4 limit = { var:nesnd_a2_facility_total < $CAP$ }
+  random_scope_state = {
+   limit = { NOT = { any_scope_building = { is_building_type = $BUILDING$ } } }
+   create_building = { building = $BUILDING$ level = 1 reserves = 1 }
+   scope:nesnd_a2_facility_country = { change_variable = { name = nesnd_a2_facility_total add = 1 } }
+  }
+ }
+ remove_variable = nesnd_a2_facility_total clear_saved_scope = nesnd_a2_facility_country
+ }
+}
+nesnd_khanate_prepare = {
+ if = { limit = { c:NKH ?= this is_country_alive = yes any_scope_state = { count = 4 state_population > 0 } NOT = { has_variable = nesnd_khanate_prepared } }
+  set_variable = nesnd_khanate_prepared
+  nesnd_hus_clear_hierarchy = yes
+  set_variable = nesnd_hus_native_legal_prepared
+  set_social_hierarchy = default_social_hierarchy
+  set_variable = nesnd_hus_hierarchy_mutating
+  nesnd_restoration_minimum_technology = yes
+  activate_law = law_type:law_monarchy activate_law = law_type:law_autocracy
+  activate_law = law_type:law_professional_army activate_law = law_type:law_slavery_banned
+  activate_law = law_type:law_racial_segregation activate_law = law_type:law_total_separation
+  activate_law = law_type:law_interventionism activate_law = law_type:law_mercantilism activate_law = law_type:law_private_schools
+  remove_variable = nesnd_hus_hierarchy_mutating
+  nesnd_khanate_facility = { BUILDING = building_arms_industry CAP = 2 }
+  nesnd_khanate_facility = { BUILDING = building_artillery_foundry CAP = 1 }
+  nesnd_khanate_facility = { BUILDING = building_tooling_workshop CAP = 2 }
+  nesnd_khanate_facility = { BUILDING = building_food_industry CAP = 2 }
+  nesnd_khanate_facility = { BUILDING = building_government_administration CAP = 4 }
+  nesnd_khanate_facility = { BUILDING = building_paper_mill CAP = 1 }
+  nesnd_khanate_facility = { BUILDING = building_construction_sector CAP = 4 }
+  every_character = { limit = { has_template = nesnd_a2_tatanka } set_global_variable = nesnd_a2_tatanka_seen }
+  every_character_in_exile_pool = { limit = { has_template = nesnd_a2_tatanka } set_global_variable = nesnd_a2_tatanka_seen }
+  every_character_in_void = { limit = { has_template = nesnd_a2_tatanka } set_global_variable = nesnd_a2_tatanka_seen }
+  if = { limit = { NOT = { has_global_variable = nesnd_a2_tatanka_seen } NOT = { has_global_variable = nesnd_a2_tatanka_dead } }
+   set_global_variable = nesnd_a2_tatanka_seen
+   create_character = { template = nesnd_a2_tatanka on_created = { set_variable = nesnd_a2_tatanka set_variable = nesnd_a2_case_character } }
+  }
+  nesnd_khanate_army = yes
+  save_scope_as = nesnd_khanate_country
+  every_state_region = { limit = { nesnd_khanate_north_america = yes } add_claim = scope:nesnd_khanate_country }
+  clear_saved_scope = nesnd_khanate_country
+  nesnd_native_primary_cultures_only = yes
+ }
+}
+nesnd_khanate_army = {
+ nesnd_a2_raise_army = { TARGET = nesnd_khanate_army_target PER_STATE = nesnd_khanate_state_capacity ARTILLERY = 0.20 STATES = 4 }
+}
+nesnd_native_primary_cultures_only = {
+    if = { limit = { OR = { c:NKH ?= this has_variable = nesnd_hus_native_successor } }
+        save_scope_as = nesnd_native_culture_country
+        # Add a fallback before removing anything: a country must retain a primary culture.
+        if = { limit = { NOT = { any_primary_culture = { nesnd_hus_native_culture = yes } } } add_primary_culture = cu:siouan }
+        every_scope_culture = {
+            limit = { nesnd_hus_native_culture = yes }
+            scope:nesnd_native_culture_country = { add_primary_culture = prev }
+        }
+        every_primary_culture = {
+            limit = { NOT = { nesnd_hus_native_culture = yes } }
+            scope:nesnd_native_culture_country = { remove_primary_culture = prev }
+        }
+        clear_saved_scope = nesnd_native_culture_country
+    }
+}
+nesnd_khanate_start_war = {
+ if = { limit = { nesnd_khanate_exists = yes }
+ if = { limit = {
+  nesnd_khanate_original_opponent = yes is_country_alive = yes nesnd_khanate_exists = yes c:NKH = { has_variable = nesnd_khanate_prepared has_variable = nesnd_khanate_usa_epoch has_variable = nesnd_khanate_hus_epoch NOT = { has_variable = nesnd_khanate_legacy_invalid } }
+  NOT = { has_variable = nesnd_khanate_war_outcome } NOT = { has_variable = nesnd_khanate_war_dispatched } NOT = { has_variable = nesnd_khanate_retry_wait }
+ }
+  if = { limit = { NOT = { has_variable = nesnd_khanate_war_attempts } } set_variable = { name = nesnd_khanate_war_attempts value = 0 } }
+  change_variable = { name = nesnd_khanate_war_attempts add = 1 }
+  set_variable = { name = nesnd_khanate_retry_wait months = 1 }
+  save_scope_as = nesnd_khanate_opponent
+  if = { limit = { NOT = { has_war_with = c:NKH } NOT = { nesnd_khanate_has_play = yes } }
+   end_truce = c:NKH
+   every_scope_treaty = {
+    limit = { binds = scope:nesnd_khanate_opponent binds = c:NKH any_scope_article = { OR = { has_type = alliance has_type = defensive_pact } } }
+    withdraw = { country = scope:nesnd_khanate_opponent apply_break_penalties = yes }
+    scope:nesnd_khanate_opponent = { set_variable = nesnd_khanate_withdrew_treaty }
+   }
+   if = { limit = { has_variable = nesnd_khanate_withdrew_treaty }
+    remove_variable = nesnd_khanate_withdrew_treaty
+    trigger_event = { id = nesnd_native_khanate.4 popup = yes }
+    c:NKH = { trigger_event = { id = nesnd_native_khanate.4 popup = yes } }
+   }
+   set_variable = nesnd_khanate_dispatch_created
+   set_variable = nesnd_khanate_creation_open
+   set_variable = { name = nesnd_khanate_creation_case value = c:NKH }
+   if = { limit = { c:USA ?= this } set_variable = { name = nesnd_khanate_creation_epoch value = c:NKH.var:nesnd_khanate_usa_epoch } }
+   else = { set_variable = { name = nesnd_khanate_creation_epoch value = c:NKH.var:nesnd_khanate_hus_epoch } }
+   c:NKH = {
+    create_diplomatic_play = {
+     name = nesnd_khanate_war type = dp_nesnd_khanate_suppression initiator = scope:nesnd_khanate_opponent war = yes handle_annexation_as_civil_war = no
+     add_war_goal = { holder = c:NKH type = wg_nesnd_khanate_humiliation country = scope:nesnd_khanate_opponent }
+    }
+   }
+   remove_variable = nesnd_khanate_creation_open remove_variable = nesnd_khanate_creation_case remove_variable = nesnd_khanate_creation_epoch
+  }
+  if = { limit = { has_variable = nesnd_khanate_dispatch_created }
+  if = { limit = { any_diplomatic_play = { count = 1 is_diplomatic_play_type = dp_nesnd_khanate_suppression initiator = scope:nesnd_khanate_opponent target = c:NKH } }
+  random_diplomatic_play = {
+   limit = { is_diplomatic_play_type = dp_nesnd_khanate_suppression initiator = scope:nesnd_khanate_opponent target = c:NKH
+    initiator = { play_participant_has_war_goal_of_type_against = { type = wg_nesnd_khanate_annex target = c:NKH } }
+    target = { play_participant_has_war_goal_of_type_against = { type = wg_nesnd_khanate_humiliation target = scope:nesnd_khanate_opponent } }
+   }
+   save_scope_as = nesnd_khanate_play
+   nesnd_khanate_bind_play = yes
+  }
+  }
+   remove_variable = nesnd_khanate_dispatch_created
+  }
+  if = { limit = { NOT = { has_variable = nesnd_khanate_war_dispatched } var:nesnd_khanate_war_attempts >= 12 }
+   set_variable = { name = nesnd_khanate_war_outcome value = 4 }
+  }
+  clear_saved_scope = nesnd_khanate_play clear_saved_scope = nesnd_khanate_opponent
+ }
+ }
+}
+nesnd_khanate_war_watch = {
+ if = { limit = { has_variable = nesnd_khanate_war_dispatched NOT = { has_variable = nesnd_khanate_war_outcome } NOT = { nesnd_khanate_has_play = yes } }
+  if = { limit = { nesnd_khanate_exists = yes } set_variable = { name = nesnd_khanate_war_outcome value = 3 } }
+  else = { set_variable = { name = nesnd_khanate_war_outcome value = 5 } }
+ }
+}
+nesnd_khanate_check_survival = {
+ if = { limit = { c:NKH ?= this has_variable = nesnd_native_khanate NOT = { has_variable = nesnd_khanate_survived_wars } }
+  if = { limit = { NOT = { var:nesnd_khanate_original_usa ?= { c:USA ?= this is_country_alive = yes } } } set_variable = { name = nesnd_khanate_usa_outcome value = 5 } }
+  else_if = { limit = { var:nesnd_khanate_original_usa = { has_variable = nesnd_khanate_war_outcome } } set_variable = { name = nesnd_khanate_usa_outcome value = var:nesnd_khanate_original_usa.var:nesnd_khanate_war_outcome } }
+  if = { limit = { NOT = { var:nesnd_khanate_original_hus ?= { nesnd_hus_original_country = yes } } } set_variable = { name = nesnd_khanate_hus_outcome value = 5 } }
+  else_if = { limit = { var:nesnd_khanate_original_hus = { has_variable = nesnd_khanate_war_outcome } } set_variable = { name = nesnd_khanate_hus_outcome value = var:nesnd_khanate_original_hus.var:nesnd_khanate_war_outcome } }
+  if = { limit = { var:nesnd_khanate_usa_outcome > 0 var:nesnd_khanate_hus_outcome > 0 }
+   set_variable = nesnd_khanate_survived_wars trigger_event = { id = nesnd_native_khanate.2 popup = yes }
+  }
+ }
+}
+nesnd_khanate_maintenance = {
+ if = { limit = { nesnd_hus_original_country = yes has_variable = nesnd_khanate_campaign_started NOT = { has_global_variable = nesnd_khanate_created } } nesnd_khanate_create = yes }
+ if = { limit = { OR = { c:USA ?= this nesnd_hus_original_country = yes } has_global_variable = nesnd_khanate_created }
+  nesnd_khanate_start_war = yes nesnd_khanate_war_watch = yes
+ }
+ if = { limit = { c:NKH ?= this has_variable = nesnd_native_khanate } nesnd_a2_khanate_legacy = yes nesnd_khanate_check_survival = yes }
+}
+nesnd_khanate_form_native_hus = {
+ if = { limit = { nesnd_khanate_can_form_hus = yes }
+  set_variable = nesnd_khanate_forming_hus set_variable = nesnd_hus_native_successor set_variable = nesnd_hus_native_legal_prepared
+  change_tag = HUS
+  if = { limit = { c:HUS ?= this }
+   nesnd_hus_clear_hierarchy = yes set_social_hierarchy = default_social_hierarchy set_variable = nesnd_hus_hierarchy_mutating
+   nesnd_khanate_successor_laws = yes
+   remove_variable = nesnd_hus_hierarchy_mutating nesnd_native_primary_cultures_only = yes
+   trigger_event = { id = nesnd_native_khanate.3 popup = yes }
+  }
+  remove_variable = nesnd_khanate_forming_hus
+ }
+}
+nesnd_khanate_successor_laws = {
+ activate_law = law_type:law_presidential_republic activate_law = law_type:law_total_separation
+ activate_law = law_type:law_census_voting activate_law = law_type:law_per_capita_based_taxation
+ activate_law = law_type:law_elected_bureaucrats activate_law = law_type:law_private_schools
+ activate_law = law_type:law_tenant_farmers activate_law = law_type:law_laissez_faire
+ activate_law = law_type:law_mercantilism activate_law = law_type:law_racial_segregation
+ activate_law = law_type:law_professional_army activate_law = law_type:law_no_migration_controls
+ activate_law = law_type:law_censorship activate_law = law_type:law_debt_slavery
+ activate_law = law_type:law_no_womens_rights activate_law = law_type:law_frontier_colonization
+ activate_law = law_type:law_no_workers_rights activate_law = law_type:law_anti_strike_laws
+ activate_law = law_type:law_merchant_navy activate_law = law_type:law_no_home_affairs
+ activate_law = law_type:law_no_police activate_law = law_type:law_no_health_system
+ activate_law = law_type:law_child_labor_allowed activate_law = law_type:law_no_social_security
+}
--- baseline/common/scripted_effects/nesnd_ottoman_recovery.txt
+++ candidate/common/scripted_effects/nesnd_ottoman_recovery.txt
@@ -0,0 +1,72 @@
+nesnd_ottoman_refresh_barracks = {
+    # State scope: remove old building attachments; country modifiers now cover battalions.
+    every_scope_building = {
+        if = { limit = { has_modifier = nesnd_ottoman_qin_supply } remove_modifier = nesnd_ottoman_qin_supply }
+        if = { limit = { has_modifier = nesnd_ottoman_qin_supply_success } remove_modifier = nesnd_ottoman_qin_supply_success }
+        if = { limit = { has_modifier = nesnd_ottoman_qin_supply_failed } remove_modifier = nesnd_ottoman_qin_supply_failed }
+    }
+}
+nesnd_ottoman_sync = {
+    if = { limit = { has_journal_entry = nesnd_ottoman_recovery }
+        je:nesnd_ottoman_recovery = { set_bar_progress = { name = nesnd_ottoman_enthusiasm_bar value = owner.nesnd_ottoman_enthusiasm_value } }
+    }
+}
+nesnd_ottoman_initialize = {
+    if = { limit = { NOT = { has_variable = nesnd_ottoman_enthusiasm } } set_variable = { name = nesnd_ottoman_enthusiasm value = 25 } }
+    nesnd_ottoman_sync = yes
+}
+nesnd_ottoman_monthly = {
+    if = {
+        limit = { nesnd_ottoman_recovery_open = yes has_journal_entry = nesnd_ottoman_recovery }
+        nesnd_ottoman_initialize = yes
+        change_variable = { name = nesnd_ottoman_enthusiasm add = nesnd_ottoman_enthusiasm_monthly }
+        set_variable = { name = nesnd_ottoman_enthusiasm value = nesnd_ottoman_enthusiasm_value }
+        nesnd_ottoman_sync = yes
+    }
+}
+nesnd_ottoman_purchase_claim = {
+    if = {
+        limit = { nesnd_ottoman_recovery_open = yes nesnd_ottoman_enthusiasm_value >= nesnd_ottoman_claim_cost s:$STATE$ = { nesnd_ottoman_claim_target = yes } }
+        s:$STATE$ = { add_claim = root }
+        if = { limit = { has_claim = s:$STATE$ }
+            change_variable = { name = nesnd_ottoman_enthusiasm subtract = nesnd_ottoman_claim_cost }
+            nesnd_ottoman_sync = yes
+        }
+    }
+}
+nesnd_ottoman_clear_reform_benefits = {
+    if = { limit = { has_modifier = nesnd_ottoman_qin_reform } remove_modifier = nesnd_ottoman_qin_reform }
+    if = { limit = { has_modifier = nesnd_ottoman_qin_reform_success } remove_modifier = nesnd_ottoman_qin_reform_success }
+    if = { limit = { has_modifier = nesnd_ottoman_qin_reform_failed } remove_modifier = nesnd_ottoman_qin_reform_failed }
+    every_scope_state = { nesnd_ottoman_refresh_barracks = yes }
+}
+nesnd_ottoman_start_reform = {
+    if = {
+        limit = {
+            nesnd_ottoman_recovery_open = yes
+            NOT = { nesnd_ottoman_reform_active = yes }
+            NOT = { has_variable = nesnd_ottoman_reform_pending }
+        }
+        set_variable = nesnd_ottoman_reform_pending
+        set_variable = { name = nesnd_ottoman_reform_term months = 12 }
+        if = { limit = { nesnd_ottoman_tanzimat_success = yes } add_modifier = { name = nesnd_ottoman_qin_reform_success months = 12 } }
+        else_if = { limit = { nesnd_ottoman_tanzimat_failed = yes } add_modifier = { name = nesnd_ottoman_qin_reform_failed months = 12 } }
+        else = { add_modifier = { name = nesnd_ottoman_qin_reform months = 12 } }
+        every_scope_state = { nesnd_ottoman_refresh_barracks = yes }
+        trigger_event = { id = nesnd_ottoman_recovery.1 months = 12 popup = no }
+    }
+}
+nesnd_ottoman_finish_reform = {
+    # The term guard also rejects an old callback after a fresh renewal.
+    if = { limit = { has_variable = nesnd_ottoman_reform_pending NOT = { has_variable = nesnd_ottoman_reform_term } }
+        nesnd_ottoman_clear_reform_benefits = yes
+        remove_variable = nesnd_ottoman_reform_pending
+    }
+}
+nesnd_ottoman_reform_maintenance = {
+    if = { limit = { NOT = { nesnd_ottoman_recovery_open = yes } }
+        # Retain the original commitment marker until its own expiry.
+        nesnd_ottoman_clear_reform_benefits = yes
+    }
+    nesnd_ottoman_finish_reform = yes
+}
--- baseline/common/scripted_effects/nesnd_ottoman_unity.txt
