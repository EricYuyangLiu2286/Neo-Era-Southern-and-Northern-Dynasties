+ OR = { owner = { c:MEX ?= this } state_region = { is_in_geographic_region = geographic_region_peru } }
+}
+nesnd_restoration_small_country = { NOT = { c:MEX ?= this } any_scope_state = { count >= 2 state_population > 0 state_region = { is_in_geographic_region = geographic_region_peru } } NOT = { any_scope_state = { count >= 5 state_population > 0 state_region = { is_in_geographic_region = geographic_region_peru } } } }
+nesnd_restoration_small_core = {
+ nesnd_restoration_native_state = yes state_population >= 200000 nesnd_restoration_core_share >= 0.4 nesnd_restoration_single_remaining >= 150000
+}
+nesnd_restoration_can_recognize = {
+ government_legitimacy >= 50 ig:ig_rural_folk = { is_in_government = yes }
+ NOT = { nesnd_restoration_pair_at_war = yes }
+ trigger_if = { limit = { nesnd_restoration_invitation_applicant = yes }
+  is_subject = no NOT = { is_at_war = yes }
+  c:TWT = { is_subject = no NOT = { is_at_war = yes } }
+  NOT = { has_variable = nesnd_restoration_request_cooldown } NOT = { has_variable = nesnd_restoration_invitation_pending }
+ }
+ trigger_else = {
+  nesnd_american_restoration_host = yes
+  trigger_if = { limit = { c:MEX ?= this } NOT = { exists = c:NAH } }
+  trigger_else = { NOT = { exists = c:TWT } }
+ }
+}
+nesnd_restoration_can_negotiate = {
+ nesnd_american_restoration_host = yes government_legitimacy >= 50
+ OR = { ig:ig_rural_folk = { is_in_government = yes } ig:ig_intelligentsia = { is_in_government = yes } }
+ NOT = { has_modifier = nesnd_native_local_councils } NOT = { nesnd_restoration_pair_at_war = yes }
+}
+nesnd_restoration_can_suppress = {
+ nesnd_american_restoration_host = yes government_legitimacy >= 50 ig:ig_armed_forces = { is_in_government = yes }
+ any_scope_state = { any_scope_pop = { culture = { nesnd_hus_native_culture = yes } } }
+ army_size >= nesnd_restoration_suppression_army NOT = { nesnd_restoration_pair_at_war = yes }
+}
+nesnd_restoration_goal_pair = {
+ trigger_if = { limit = { exists = scope:target_country exists = scope:diplomatic_play has_variable = nesnd_restoration_epoch exists = var:nesnd_restoration_opponent }
+  scope:diplomatic_play = { is_diplomatic_play_type = dp_nesnd_native_restoration }
+  var:nesnd_restoration_opponent = scope:target_country
+  scope:target_country = {
+   trigger_if = { limit = { has_variable = nesnd_restoration_epoch exists = var:nesnd_restoration_opponent }
+    var:nesnd_restoration_epoch = root.var:nesnd_restoration_epoch
+    var:nesnd_restoration_opponent = root
+   }
+   trigger_else = { always = no }
+  }
+  OR = { has_variable = nesnd_restoration_rebel has_variable = nesnd_restoration_war_host }
+  scope:diplomatic_play = { OR = { AND = { initiator = root target = scope:target_country } AND = { target = root initiator = scope:target_country } } }
+ }
+ trigger_else = { always = no }
+}
+
+nesnd_restoration_invitation_live = {
+ nesnd_restoration_existing_court = yes is_subject = no NOT = { is_at_war = yes }
+ trigger_if = { limit = { exists = scope:nesnd_restoration_applicant exists = scope:nesnd_restoration_request_epoch exists = scope:nesnd_restoration_requested_court exists = scope:nesnd_restoration_court_epoch has_variable = nesnd_restoration_epoch }
+  this = scope:nesnd_restoration_requested_court
+  var:nesnd_restoration_epoch = scope:nesnd_restoration_court_epoch
+  scope:nesnd_restoration_applicant = {
+   nesnd_restoration_invitation_applicant = yes is_subject = no NOT = { is_at_war = yes }
+   government_legitimacy >= 50 ig:ig_rural_folk = { is_in_government = yes }
+   NOT = { nesnd_restoration_pair_at_war = yes }
+   trigger_if = { limit = { has_variable = nesnd_restoration_invitation_pending has_variable = nesnd_restoration_request_epoch }
+    var:nesnd_restoration_request_epoch = scope:nesnd_restoration_request_epoch
+   }
+   trigger_else = { always = no }
+  }
+ }
+ trigger_else = { always = no }
+}
+
+# Country identity and local eligibility are separate from opening a new case.
+nesnd_andean_restoration_country = {
+ is_country_alive = yes OR = { c:PEU ?= this c:NPU ?= this c:SPU ?= this }
+ NOT = { has_variable = nesnd_restoration_local_closed }
+ any_scope_state = { state_population > 0 state_region = { is_in_geographic_region = geographic_region_peru } }
+ any_scope_state = { state_population > 0 any_scope_pop = { culture = { nesnd_hus_native_culture = yes } } }
+}
+nesnd_restoration_existing_court = {
+ c:TWT ?= this is_country_alive = yes has_variable = nesnd_restoration_rebel has_variable = nesnd_a2_restoration_adopted
+ trigger_if = { limit = { has_variable = nesnd_restoration_epoch has_global_variable = nesnd_andean_restoration_case_epoch has_global_variable = nesnd_andean_restoration_case_country }
+  global_var:nesnd_andean_restoration_case_country ?= this
+  var:nesnd_restoration_epoch = global_var:nesnd_andean_restoration_case_epoch
+ }
+ trigger_else = { always = no }
+}
+nesnd_restoration_invitation_applicant = {
+ nesnd_andean_restoration_country = yes
+ trigger_if = { limit = { exists = c:TWT } c:TWT = { nesnd_restoration_existing_court = yes } }
+ trigger_else = { always = no }
+}
+nesnd_restoration_entry_visible = {
+ OR = { nesnd_american_restoration_host = yes nesnd_restoration_invitation_applicant = yes }
+}
--- baseline/common/scripted_triggers/nesnd_canon_diplomacy.txt
+++ candidate/common/scripted_triggers/nesnd_canon_diplomacy.txt
@@ -0,0 +1,147 @@
+nesnd_canon_german_country = { any_primary_culture = { OR = { this = cu:north_german this = cu:south_german } } }
+nesnd_canon_italian_country = { any_primary_culture = { OR = { this = cu:north_italian this = cu:south_italian } } }
+nesnd_canon_european_investor = { OR = { c:FRA ?= this c:GBR ?= this c:PRU ?= this c:NGF ?= this c:GER ?= this } }
+nesnd_canon_request_free = {
+    custom_tooltip = { text = nesnd_canon_no_pending_reply NOT = { has_variable = nesnd_canon_request_clock } }
+    custom_tooltip = { text = nesnd_canon_diplomatic_cooldown NOT = { has_variable = nesnd_canon_request_cooldown } }
+}
+nesnd_canon_pair_valid = {
+    trigger_if = { limit = { exists = scope:canon_sender exists = scope:canon_partner }
+        scope:canon_sender = { is_country_alive = yes NOT = { this = scope:canon_partner } NOT = { has_war_with = scope:canon_partner } }
+        scope:canon_partner = { is_country_alive = yes }
+    }
+    trigger_else = { always = no }
+}
+nesnd_canon_reply_valid = {
+    trigger_if = { limit = { exists = scope:canon_sender exists = scope:canon_partner exists = scope:canon_serial exists = scope:canon_kind exists = scope:canon_sender_regime exists = scope:canon_partner_regime }
+        nesnd_canon_pair_valid = yes
+        this = scope:canon_partner
+        nesnd_canon_regime = scope:canon_partner_regime
+        scope:canon_sender = {
+            has_variable = nesnd_canon_request_clock
+            nesnd_canon_request_serial = scope:canon_serial
+            nesnd_canon_request_kind = scope:canon_kind
+            nesnd_canon_regime = scope:canon_sender_regime
+            trigger_if = { limit = { exists = var:nesnd_canon_request_partner } var:nesnd_canon_request_partner = scope:canon_partner }
+            trigger_else = { always = no }
+        }
+    }
+    trigger_else = { always = no }
+}
+nesnd_canon_request_eligible = {
+    trigger_if = { limit = { exists = scope:canon_sender exists = scope:canon_partner exists = scope:canon_kind }
+        nesnd_canon_pair_valid = yes
+        trigger_if = { limit = { OR = { scope:canon_kind = 6 scope:canon_kind = 7 scope:canon_kind = 8 } } always = yes }
+        trigger_else = { scope:canon_sender = { "relations(scope:canon_partner)" >= 20 } }
+        trigger_if = { limit = { OR = { scope:canon_kind = 1 scope:canon_kind = 11 } }
+            scope:canon_sender = { nesnd_prussian_identity = yes is_subject = no }
+            scope:canon_partner = { nesnd_canon_german_partner = yes }
+            trigger_if = { limit = { scope:canon_kind = 1 }
+                can_create_treaty = { first_country = scope:canon_sender second_country = scope:canon_partner is_draft = no binding_period = { years = 5 } articles_to_create = { { article = alliance } } }
+            }
+            trigger_else = {
+                can_create_treaty = { first_country = scope:canon_sender second_country = scope:canon_partner is_draft = no binding_period = { years = 5 } articles_to_create = { { article = defensive_pact } } }
+            }
+        }
+        trigger_else_if = { limit = { OR = { scope:canon_kind = 2 scope:canon_kind = 5 } }
+            exists = scope:canon_partner
+            scope:canon_partner ?= { is_subject = no }
+            trigger_if = { limit = { scope:canon_kind = 2 }
+                scope:canon_sender = { nesnd_usa_continental_identity = yes }
+                scope:canon_partner = { nesnd_canon_european_investor = yes }
+            }
+            trigger_else = {
+                # B2 supplies the real small-state eligibility; no placeholder definition here.
+                scope:canon_sender = { nesnd_small_state_country = yes nesnd_small_investment_eligible = yes }
+                scope:canon_partner = { OR = { c:FRA ?= this c:GBR ?= this c:USM ?= this c:MUG ?= this c:HUS ?= this } }
+            }
+            can_create_treaty = { first_country = scope:canon_sender second_country = scope:canon_partner is_draft = no binding_period = { years = 5 } articles_to_create = { { article = foreign_investment_rights source_country = scope:canon_sender target_country = scope:canon_partner } } }
+        }
+        trigger_else_if = { limit = { scope:canon_kind = 3 }
+            # Political credit only; the Italian route supplies its substantive policy eligibility.
+            scope:canon_sender = { nesnd_italy_country = yes NOT = { has_variable = nesnd_italy_french_guarantee } }
+            scope:canon_partner = { c:FRA ?= this }
+        }
+        trigger_else_if = { limit = { scope:canon_kind = 4 }
+            scope:canon_sender = { c:AUS ?= this is_subject = no }
+            scope:canon_partner = { nesnd_canon_italian_country = yes is_subject = no NOT = { c:ITA ?= this } }
+            can_create_treaty = { first_country = scope:canon_sender second_country = scope:canon_partner is_draft = no binding_period = { years = 5 } articles_to_create = { { article = defensive_pact } } }
+        }
+        trigger_else_if = { limit = { OR = { scope:canon_kind = 6 scope:canon_kind = 7 scope:canon_kind = 8 scope:canon_kind = 9 } }
+            nesnd_small_request_eligible = yes
+        }
+        trigger_else = { always = no }
+    }
+    trigger_else = { always = no }
+}
+nesnd_canon_treaty_result = {
+    trigger_if = { limit = { exists = scope:canon_sender exists = scope:canon_partner exists = scope:canon_kind }
+        scope:canon_sender = {
+            trigger_if = { limit = { scope:canon_kind = 1 } has_treaty_alliance_with = { TARGET = scope:canon_partner } }
+            trigger_else_if = { limit = { OR = { scope:canon_kind = 4 scope:canon_kind = 11 } } has_treaty_defensive_pact_with = { TARGET = scope:canon_partner } }
+            trigger_else_if = { limit = { OR = { scope:canon_kind = 2 scope:canon_kind = 5 } }
+                any_scope_treaty = { binds = scope:canon_partner any_scope_article = { nesnd_canon_directed_article = { TYPE = foreign_investment_rights SOURCE = scope:canon_sender TARGET = scope:canon_partner } } }
+            }
+            trigger_else_if = { limit = { scope:canon_kind = 3 } has_variable = nesnd_italy_french_guarantee has_modifier = nesnd_italy_french_credit }
+            trigger_else_if = { limit = { OR = { scope:canon_kind = 6 scope:canon_kind = 7 scope:canon_kind = 8 scope:canon_kind = 9 } } nesnd_small_request_result = yes }
+            trigger_else = { always = no }
+        }
+    }
+    trigger_else = { always = no }
+}
+nesnd_canon_investment_valid = {
+    trigger_if = { limit = { exists = var:nesnd_canon_investor }
+        var:nesnd_canon_investor = { is_country_alive = yes is_subject = no }
+        NOT = { has_war_with = var:nesnd_canon_investor }
+        save_temporary_scope_as = canon_host
+        var:nesnd_canon_investor = { save_temporary_scope_as = canon_capital_country }
+        any_scope_treaty = { binds = scope:canon_capital_country any_scope_article = { nesnd_canon_directed_article = { TYPE = foreign_investment_rights SOURCE = scope:canon_host TARGET = scope:canon_capital_country } } }
+    }
+    trigger_else = { always = no }
+}
+
+nesnd_canon_event_kind = {
+    trigger_if = { limit = { exists = scope:canon_kind } scope:canon_kind = $VALUE$ }
+    trigger_else = { always = no }
+}
+nesnd_canon_german_partner = {
+    is_country_alive = yes is_subject = no nesnd_canon_german_country = yes NOT = { c:FRM ?= this }
+    custom_tooltip = { text = nesnd_canon_no_french_alliance_tt
+        trigger_if = { limit = { exists = c:FRA } NOT = { has_treaty_alliance_with = { TARGET = c:FRA } } }
+        trigger_else = { always = yes }
+    }
+}
+
+# Mutual articles have no source/target links; inspect directed links only after presence checks.
+nesnd_canon_directed_article = {
+    trigger_if = { limit = { exists = source_country exists = target_country }
+        has_type = $TYPE$ source_country = $SOURCE$ target_country = $TARGET$
+    }
+    trigger_else = { always = no }
+}
+nesnd_canon_available_european_article = {
+    trigger_if = { limit = { exists = source_country exists = target_country exists = scope:canon_current_host }
+        has_type = foreign_investment_rights source_country = scope:canon_current_host
+        target_country = { is_country_alive = yes is_subject = no nesnd_canon_european_investor = yes NOT = { has_war_with = scope:canon_current_host } }
+    }
+    trigger_else = { always = no }
+}
