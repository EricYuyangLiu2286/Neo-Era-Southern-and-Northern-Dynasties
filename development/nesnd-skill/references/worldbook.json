  "entries": [
    {
      "id": "ming-federal-structure",
      "activation_keywords": [
        "南明",
        "大明联邦",
        "南府",
        "西府",
        "淮宁相禅"
      ],
      "era": "18世纪—代明危机",
      "status": "text_attested",
      "claims": [
        "朱姓君主与吴、蜀、楚、淮等地方权力并存；吴国控制军政资源而不等于已经称帝。",
        "淮宁相禅使两系宗室轮替；郑氏在杭州另设五军都督府。",
        "科举代议扩大地方士人参与，同时将中央集权与商业土地利益相联。"
      ],
      "sources": [
        "北明ppet:slides8-9",
        "朱班博传（中）:paragraphs17-24"
      ]
    },
    {
      "id": "huguang-institutions",
      "activation_keywords": [
        "湖广",
        "襄阳",
        "朱班博",
        "石元抚",
        "积蓄力量"
      ],
      "era": "1815以后；1836条件化继承",
      "status": "text_attested",
      "claims": [
        "军事防御、运输和后勤来自总督府组织能力；不能把朱班博写成只有忠诚的武夫。",
        "军工钢铁换粮、退伍军人屯垦、书院和共和派军政人才构成储备。",
        "土地流动引发投机与流民问题；石元抚质疑改革受益者，朱班博倾向忠于制度并保持清白。"
      ],
      "sources": [
        "朱班博传（中）:paragraphs12-35",
        "朱班博传（上）:paragraphs14-19,49-63"
      ]
    },
    {
      "id": "wu-succession",
      "activation_keywords": [
        "郑钦",
        "郑莒",
        "大吴",
        "禅让",
        "反吴复明"
      ],
      "era": "代明危机；年份不强制",
      "status": "text_attested",
      "claims": [
        "既定叙事中郑钦生前不称帝，孙郑莒即位后接收朝臣拥戴，明帝禅让。",
        "反对方包括湖广朱绛臣、四川魏鉴和萧兴华、淮藩朱靖堙及杨秀清。",
        "吴方依靠曾国藩、李鸿章、友季高、吴直弼及日裔军队；平乱后撤藩直辖，同时发生暴行和内陆压迫。",
        "游戏可逆转此进程，但新分支不自动成为小说正史。"
      ],
      "sources": [
        "北明ppet:slide17 paragraphs9-17"
      ]
    },
    {
      "id": "chen-reform-divergence",
      "activation_keywords": [
        "陈东阳",
        "万族",
        "改革",
        "暗杀"
      ],
      "era": "1815—1838及可选存活线",
      "status": "text_attested",
      "claims": [
        "共和派陈东阳推动南朝法治、科举代议与行政改革，曾与郑钦合作。",
        "改革推进后双方分道扬镳，PPT写1838年罢免、出海时遇毒杀；游戏应允许保护、流亡或失败的条件分支。",
        "不能把万族主义等同于当代民主，也不能因其后来的极端挪用否认角色当前思想。"
      ],
      "sources": [
        "北明ppet:slides15,17",
        "朱班博传（中）:paragraphs10-24"
      ]
    },
    {
      "id": "north-constraints",
      "activation_keywords": [
        "牧仲棠",
        "中华帝国",
        "西秦",
        "山西",
        "共和派",
        "土地改革"
      ],
      "era": "革命后—1836及后续",
      "status": "text_attested",
      "claims": [
        "牧氏从革命军崛起为帝国统治者，军事、民族统一诉求与共和派存在深刻冲突。",
        "既定故事山西共和派起兵，但周围土地秩序稳定、群众厌恶内战，未能扩张。",
        "西秦复仇受此前重败与军士/武勋集团反对约束，仍与俄、波斯、莫卧儿争夺影响。",
        "北方是否干预南方应看财政、改革压力、国内动乱和西线压力，不使用无条件禁止。"
      ],
      "sources": [
        "北明ppet:slides12-13",
        "朱班博传（中）:paragraphs16,38-43",
        "北明人物列传:paragraph102"
      ]
    },
    {
      "id": "overseas-interests",
      "activation_keywords": [
        "南洋",
        "日本",
        "澳洲",
        "远南",
        "华美",
        "东洲"
      ],
      "era": "1836前后",
      "status": "text_attested",
      "claims": [
        "南明远洋网络和日裔军官是长期制度关系，内战应影响军费、商路、驻军与地方自主。",
        "东洲共和国的殖民起源及反吴独立历史可影响庇护/贸易选择；不能将1919统一后的华美政体倒置到1836。",
        "20世纪海军人物及潜艇/航母战经历不是1836可用角色。"
      ],
      "sources": [
        "北明ppet:slides9,18",
        "海军人物:paragraphs1-21,24-144"
      ]
    },
    {
      "id": "minorities-land",
      "activation_keywords": [
        "骆军",
        "两广",
        "族群",
        "地主",
        "土地兼并"
      ],
      "era": "15世纪背景；长期遗产",
      "status": "text_attested",
      "claims": [
        "土地掠夺、军事财政压力及人为激化的族群矛盾造成组织化反抗。",
        "镇压、招抚、地方自治及后来的军队收编是不同路径。",
        "这仅为制度因果参考，不在1836复活骆王。"
      ],
      "sources": [
        "骆军始末:paragraphs11-51"
      ]
    },
    {
      "id": "chronology-variants",
      "activation_keywords": [
        "1805",
        "1810",
        "1819",
        "1820",
        "称帝",
        "革命"
      ],
      "era": "背景年代冲突",
      "status": "unresolved_variant",
      "claims": [
        "PPT及列传的革命起点和称帝日年有冲突；分别保存，不平均。",
        "附件地图为南征时代形势，不覆盖1836疆界。",
        "1836危机的时机由游戏条件决定，具体小说硬日期仅在作者明确要求时锁定。"
      ],
      "sources": [
        "北明ppet:slides10,12,15-16",
        "北明人物列传:paragraphs102,318-320",
        "朱班博传（中）:paragraphs36-43"
      ]
    }
  ]
}